# ===================================================================
# SPOTIFY AMÉRICAS - EXPORTAÇÃO PARA POWER BI
# ===================================================================
# Autor: Seu Nome
# Data: 2024
# Objetivo: Exportar dados tratados para criação de dashboard no Power BI
# 
# Este notebook gera 9 arquivos CSV otimizados para importação no Power BI:
#   01_tabela_fato.csv - Base principal com todos os detalhes
#   02_dimensao_pais.csv - Métricas agregadas por país
#   03_top_100_musicas.csv - Ranking das 100 músicas mais ouvidas
#   04_top_50_artistas.csv - Ranking dos 50 artistas mais ouvidos
#   05_serie_temporal.csv - Evolução semanal de streams
#   06_perfil_musical.csv - Distribuição de perfis musicais
#   07_analise_sub_regioes.csv - Comparação entre sub-regiões
#   08_streams_por_mes.csv - Sazonalidade mensal
#   09_kpis.csv - Métricas principais para cards
#   metadados.json - Documentação dos dados
# ===================================================================

import pandas as pd
import numpy as np
import os
import json
from datetime import datetime

print("=" * 70)
print("📊 EXPORTAÇÃO PARA POWER BI - SPOTIFY AMÉRICAS")
print("=" * 70)
print("\n🎯 Objetivo: Gerar arquivos otimizados para dashboard no Power BI")

# ===================================================================
# 1. MONTAR GOOGLE DRIVE
# ===================================================================

print("\n📌 1. Montando Google Drive...")
print("-" * 40)

from google.colab import drive
drive.mount('/content/drive')

print("✅ Google Drive montado com sucesso!")

# ===================================================================
# 2. CARREGAR OS DADOS LIMPOS
# ===================================================================

print("\n📌 2. Carregando dados limpos...")
print("-" * 40)

# Caminho dos dados no Drive (priorizar Parquet)
caminhos_possiveis = [
    '/content/drive/MyDrive/spotify_americas_data/spotify_americas_clean.parquet',
    '/content/drive/MyDrive/spotify_americas_clean.parquet',
    '/content/drive/MyDrive/spotify_americas_data/spotify_americas_clean.csv',
    '/content/drive/MyDrive/spotify_americas_clean.csv'
]

caminho_dados = None
for caminho in caminhos_possiveis:
    if os.path.exists(caminho):
        caminho_dados = caminho
        break

if caminho_dados is None:
    print("❌ Arquivo de dados não encontrado!")
    print("   Verifique se você executou o notebook 01_ETL_limpeza_americas.ipynb primeiro.")
    raise FileNotFoundError("Dados não encontrados")

# Carregar dados
print(f"📂 Carregando: {caminho_dados}")
if caminho_dados.endswith('.parquet'):
    df = pd.read_parquet(caminho_dados)
    print("✅ Dados carregados do formato Parquet (otimizado)")
else:
    df = pd.read_csv(caminho_dados)
    print("✅ Dados carregados do formato CSV")

print(f"\n📊 Estatísticas dos dados:")
print(f"   • Registros: {len(df):,}")
print(f"   • Colunas: {len(df.columns)}")
print(f"   • Países: {df['country'].nunique()}")
print(f"   • Músicas: {df['track_name'].nunique():,}")
print(f"   • Artistas: {df['artist_names'].nunique():,}")

# ===================================================================
# 3. CRIAR PASTA DE SAÍDA
# ===================================================================

print("\n📌 3. Criando pasta de saída...")
print("-" * 40)

output_dir = '/content/drive/MyDrive/spotify_powerbi/'
os.makedirs(output_dir, exist_ok=True)
print(f"📁 Pasta criada: {output_dir}")

# ===================================================================
# 4. TABELA 1: Tabela Fato (Base Principal)
# ===================================================================

print("\n📌 4. Criando Tabela Fato...")
print("-" * 40)

colunas_fato = ['track_name', 'artist_names', 'country', 'rank', 'streams_millions', 'week']
colunas_extras = ['sub_region', 'year', 'month', 'danceability', 'energy', 'valence', 'music_profile']

for col in colunas_extras:
    if col in df.columns:
        colunas_fato.append(col)

colunas_fato = [col for col in colunas_fato if col in df.columns]
df_fato = df[colunas_fato].copy()

# Renomear para português (facilita no Power BI)
rename = {
    'track_name': 'musica',
    'artist_names': 'artista',
    'country': 'pais',
    'streams_millions': 'streams_milhoes',
    'week': 'data',
    'sub_region': 'sub_regiao',
    'danceability': 'dancabilidade',
    'music_profile': 'perfil_musical'
}
df_fato = df_fato.rename(columns={k: v for k, v in rename.items() if k in df_fato.columns})

# Converter data
df_fato['data'] = pd.to_datetime(df_fato['data'])

# Salvar
df_fato.to_csv(f'{output_dir}01_tabela_fato.csv', index=False)
print(f"   ✅ 01_tabela_fato.csv - {len(df_fato):,} registros")
print(f"   📋 Colunas: {list(df_fato.columns)}")

# ===================================================================
# 5. TABELA 2: Dimensão País
# ===================================================================

print("\n📌 5. Criando Dimensão País...")
print("-" * 40)

df_pais = df.groupby('country').agg({
    'streams_millions': ['sum', 'mean'],
    'danceability': 'mean',
    'energy': 'mean',
    'valence': 'mean',
    'track_name': 'count',
    'artist_names': 'nunique'
}).round(3)

df_pais.columns = [
    'total_streams', 'media_streams',
    'dancabilidade', 'energia', 'valencia',
    'total_musicas', 'total_artistas'
]
df_pais = df_pais.reset_index()

# Adicionar sub-região se disponível
if 'sub_region' in df.columns:
    sub_map = df.groupby('country')['sub_region'].first()
    df_pais['sub_regiao'] = df_pais['country'].map(sub_map)

# Calcular participação percentual
total_global = df_pais['total_streams'].sum()
df_pais['participacao_percentual'] = (df_pais['total_streams'] / total_global * 100).round(1)

# Ordenar
df_pais = df_pais.sort_values('total_streams', ascending=False)

df_pais.to_csv(f'{output_dir}02_dimensao_pais.csv', index=False)
print(f"   ✅ 02_dimensao_pais.csv - {len(df_pais)} países")
print(f"   📋 Top 5: {df_pais.head(3)['country'].tolist()}")

# ===================================================================
# 6. TABELA 3: Top 100 Músicas
# ===================================================================

print("\n📌 6. Criando Top 100 Músicas...")
print("-" * 40)

df_top_musicas = (df.groupby(['track_name', 'artist_names'])['streams_millions']
                  .sum()
                  .sort_values(ascending=False)
                  .head(100)
                  .reset_index())
df_top_musicas.columns = ['musica', 'artista', 'streams_milhoes']

df_top_musicas.to_csv(f'{output_dir}03_top_100_musicas.csv', index=False)
print(f"   ✅ 03_top_100_musicas.csv - {len(df_top_musicas)} músicas")
print(f"   🎵 Música #1: {df_top_musicas.iloc[0]['musica'][:40]}...")

# ===================================================================
# 7. TABELA 4: Top 50 Artistas
# ===================================================================

print("\n📌 7. Criando Top 50 Artistas...")
print("-" * 40)

df_top_artistas = (df.groupby('artist_names')['streams_millions']
                   .sum()
                   .sort_values(ascending=False)
                   .head(50)
                   .reset_index())
df_top_artistas.columns = ['artista', 'streams_milhoes']

df_top_artistas.to_csv(f'{output_dir}04_top_50_artistas.csv', index=False)
print(f"   ✅ 04_top_50_artistas.csv - {len(df_top_artistas)} artistas")
print(f"   🎤 Artista #1: {df_top_artistas.iloc[0]['artista'][:40]}...")

# ===================================================================
# 8. TABELA 5: Série Temporal
# ===================================================================

print("\n📌 8. Criando Série Temporal...")
print("-" * 40)

df['week'] = pd.to_datetime(df['week'])
df_temporal = df.groupby('week').agg({
    'streams_millions': 'sum',
    'rank': 'mean'
}).reset_index()
df_temporal.columns = ['data', 'streams_milhoes', 'rank_medio']

df_temporal.to_csv(f'{output_dir}05_serie_temporal.csv', index=False)
print(f"   ✅ 05_serie_temporal.csv - {len(df_temporal)} semanas")
print(f"   📅 Período: {df_temporal['data'].min().date()} a {df_temporal['data'].max().date()}")

# ===================================================================
# 9. TABELA 6: Perfil Musical
# ===================================================================

print("\n📌 9. Criando Perfil Musical...")
print("-" * 40)

if 'music_profile' in df.columns:
    df_perfil = df.groupby('music_profile').agg({
        'streams_millions': 'sum',
        'track_name': 'count'
    }).round(2).reset_index()
    df_perfil.columns = ['perfil_musical', 'total_streams_m', 'total_musicas']
    
    # Calcular percentuais
    df_perfil['percentual_streams'] = (df_perfil['total_streams_m'] / df_perfil['total_streams_m'].sum() * 100).round(1)
    df_perfil['percentual_musicas'] = (df_perfil['total_musicas'] / df_perfil['total_musicas'].sum() * 100).round(1)
    
    df_perfil.to_csv(f'{output_dir}06_perfil_musical.csv', index=False)
    print(f"   ✅ 06_perfil_musical.csv - {len(df_perfil)} perfis")
    
    # Mostrar distribuição
    for _, row in df_perfil.head().iterrows():
        print(f"      • {row['perfil_musical']}: {row['percentual_streams']:.1f}% dos streams")
else:
    print("   ⚠️ Coluna 'music_profile' não encontrada - pulando")

# ===================================================================
# 10. TABELA 7: Análise por Sub-região
# ===================================================================

print("\n📌 10. Criando Análise por Sub-região...")
print("-" * 40)

if 'sub_region' in df.columns:
    df_regiao = df.groupby('sub_region').agg({
        'streams_millions': 'sum',
        'danceability': 'mean',
        'energy': 'mean',
        'valence': 'mean',
        'country': 'nunique'
    }).round(3).reset_index()
    df_regiao.columns = ['sub_regiao', 'total_streams', 'dancabilidade', 'energia', 'valencia', 'total_paises']
    
    # Ordenar por total de streams
    df_regiao = df_regiao.sort_values('total_streams', ascending=False)
    
    df_regiao.to_csv(f'{output_dir}07_analise_sub_regioes.csv', index=False)
    print(f"   ✅ 07_analise_sub_regioes.csv - {len(df_regiao)} regiões")
    
    for _, row in df_regiao.iterrows():
        print(f"      • {row['sub_regiao']}: {row['total_streams']:.1f}M streams")
else:
    print("   ⚠️ Coluna 'sub_region' não encontrada - pulando")

# ===================================================================
# 11. TABELA 8: Streams por Mês (Sazonalidade)
# ===================================================================

print("\n📌 11. Criando Streams por Mês...")
print("-" * 40)

# Criar coluna de mês
df_mensal = df.groupby(df['week'].dt.to_period('M')).agg({
    'streams_millions': 'sum'
}).reset_index()
df_mensal.columns = ['mes', 'streams_milhoes']
df_mensal['mes'] = df_mensal['mes'].astype(str)
df_mensal['ano'] = df_mensal['mes'].str[:4]
df_mensal['mes_num'] = df_mensal['mes'].str[5:7].astype(int)

# Adicionar nome do mês
nomes_meses = {1: 'Janeiro', 2: 'Fevereiro', 3: 'Março', 4: 'Abril', 
               5: 'Maio', 6: 'Junho', 7: 'Julho', 8: 'Agosto', 
               9: 'Setembro', 10: 'Outubro', 11: 'Novembro', 12: 'Dezembro'}
df_mensal['mes_nome'] = df_mensal['mes_num'].map(nomes_meses)

df_mensal = df_mensal.sort_values('mes')
df_mensal.to_csv(f'{output_dir}08_streams_por_mes.csv', index=False)
print(f"   ✅ 08_streams_por_mes.csv - {len(df_mensal)} meses")

# Mostrar meses com mais streams
top_meses = df_mensal.nlargest(3, 'streams_milhoes')[['mes_nome', 'ano', 'streams_milhoes']]
for _, row in top_meses.iterrows():
    print(f"      • {row['mes_nome']}/{row['ano']}: {row['streams_milhoes']:.1f}M streams")

# ===================================================================
# 12. TABELA 9: KPIs para Cards
# ===================================================================

print("\n📌 12. Criando KPIs para Cards...")
print("-" * 40)

kpis = pd.DataFrame({
    'KPI': [
        'Total de Streams (M)',
        'Total de Músicas',
        'Total de Artistas',
        'Total de Países',
        'Dançabilidade Média',
        'Energia Média',
        'Positividade Média',
        'Média de Streams por Música',
        'Período Início',
        'Período Fim'
    ],
    'Valor': [
        f"{df['streams_millions'].sum():.1f}",
        f"{df['track_name'].nunique():,}",
        f"{df['artist_names'].nunique():,}",
        f"{df['country'].nunique()}",
        f"{df['danceability'].mean():.3f}",
        f"{df['energy'].mean():.3f}",
        f"{df['valence'].mean():.3f}",
        f"{df['streams_millions'].mean():.2f}",
        df['week'].min().strftime('%d/%m/%Y'),
        df['week'].max().strftime('%d/%m/%Y')
    ]
})

kpis.to_csv(f'{output_dir}09_kpis.csv', index=False)
print(f"   ✅ 09_kpis.csv - {len(kpis)} KPIs")
print(f"   📊 Total de streams: {df['streams_millions'].sum():.1f}M")

# ===================================================================
# 13. METADADOS (Documentação)
# ===================================================================

print("\n📌 13. Criando Metadados...")
print("-" * 40)

metadados = {
    'projeto': 'Spotify Américas - Dashboard Power BI',
    'versao': '1.0',
    'data_exportacao': datetime.now().isoformat(),
    'total_registros': int(len(df)),
    'total_paises': int(df['country'].nunique()),
    'total_musicas': int(df['track_name'].nunique()),
    'total_artistas': int(df['artist_names'].nunique()),
    'periodo_inicio': df['week'].min().isoformat(),
    'periodo_fim': df['week'].max().isoformat(),
    'total_streams_milhoes': float(df['streams_millions'].sum()),
    'media_dancabilidade': float(df['danceability'].mean()),
    'media_energia': float(df['energy'].mean()),
    'media_valence': float(df['valence'].mean()),
    'arquivos_gerados': [
        '01_tabela_fato.csv',
        '02_dimensao_pais.csv',
        '03_top_100_musicas.csv',
        '04_top_50_artistas.csv',
        '05_serie_temporal.csv',
        '06_perfil_musical.csv',
        '07_analise_sub_regioes.csv',
        '08_streams_por_mes.csv',
        '09_kpis.csv'
    ]
}

with open(f'{output_dir}metadados.json', 'w', encoding='utf-8') as f:
    json.dump(metadados, f, indent=2, ensure_ascii=False)

print(f"   ✅ metadados.json")

# ===================================================================
# 14. RESUMO FINAL
# ===================================================================

print("\n" + "=" * 70)
print("✅ EXPORTAÇÃO CONCLUÍDA COM SUCESSO!")
print("=" * 70)

print(f"""
📁 LOCALIZAÇÃO DOS ARQUIVOS:
   {output_dir}

📋 ARQUIVOS GERADOS ({len(metadados['arquivos_gerados'])} arquivos):
   01_tabela_fato.csv      - {len(df_fato):,} registros (base principal)
   02_dimensao_pais.csv    - {len(df_pais)} países
   03_top_100_musicas.csv  - {len(df_top_musicas)} músicas
   04_top_50_artistas.csv  - {len(df_top_artistas)} artistas
   05_serie_temporal.csv   - {len(df_temporal)} semanas
   06_perfil_musical.csv   - {len(df_perfil) if 'df_perfil' in dir() else 0} perfis
   07_analise_sub_regioes.csv - {len(df_regiao) if 'df_regiao' in dir() else 0} regiões
   08_streams_por_mes.csv  - {len(df_mensal)} meses
   09_kpis.csv             - {len(kpis)} KPIs
   metadados.json          - Documentação

📊 RESUMO DOS DADOS:
   • Total de streams: {df['streams_millions'].sum():.1f}M
   • Período: {df['week'].min().date()} a {df['week'].max().date()}
   • Países: {df['country'].nunique()}
   • Músicas: {df['track_name'].nunique():,}
   • Artistas: {df['artist_names'].nunique():,}

🎯 PRÓXIMO PASSO - POWER BI:
   1. Baixe a pasta '{output_dir.split('/')[-2]}' do seu Google Drive
   2. Abra o Power BI Desktop
   3. Clique em "Obter Dados" → "Texto/CSV"
   4. Selecione os arquivos gerados
   5. Crie os relacionamentos e construa seu dashboard!
""")

print("=" * 70)

# ===================================================================
# 15. BAIXAR ARQUIVOS (OPCIONAL)
# ===================================================================

baixar = input("\n📥 Deseja baixar os arquivos zipados? (s/n): ").lower()

if baixar == 's':
    import zipfile
    from google.colab import files
    
    print("\n📦 Compactando arquivos...")
    zip_path = '/content/spotify_powerbi.zip'
    with zipfile.ZipFile(zip_path, 'w') as zipf:
        for arquivo in os.listdir(output_dir):
            zipf.write(os.path.join(output_dir, arquivo), arquivo)
    
    print("✅ Arquivos compactados!")
    files.download(zip_path)
    print("✅ Download iniciado!")
else:
    print("\n💡 Para baixar depois, acesse: https://drive.google.com e baixe a pasta 'spotify_powerbi'")

print("\n🎉 Notebook concluído! Seus dados estão prontos para o Power BI!")
